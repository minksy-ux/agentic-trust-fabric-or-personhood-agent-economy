{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentictrust.example/specs/insurance-policy.json",
  "title": "Agent Insurance Policy",
  "type": "object",
  "required": ["schemaVersion", "id", "insuredDid", "underwriterDid", "currency", "coverageAmountMinor", "deductibleAmountMinor", "coveredTaskTypes", "expiresAt", "signature"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "insuredDid": { "type": "string", "pattern": "^did:" },
    "underwriterDid": { "type": "string", "pattern": "^did:" },
    "currency": { "type": "string", "minLength": 1 },
    "coverageAmountMinor": { "type": "integer", "minimum": 1 },
    "deductibleAmountMinor": { "type": "integer", "minimum": 0 },
    "coveredTaskTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "expiresAt": { "type": "string", "format": "date-time" },
    "signature": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}