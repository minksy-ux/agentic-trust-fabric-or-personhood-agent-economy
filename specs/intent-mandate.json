{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentictrust.example/specs/intent-mandate.json",
  "title": "Intent Mandate",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "sponsorDid",
    "agentDid",
    "allowedTaskTypes",
    "maxSpend",
    "currency",
    "validFrom",
    "expiresAt",
    "policyVersion",
    "delegation",
    "policy",
    "nonce",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "sponsorDid": { "type": "string", "pattern": "^did:" },
    "agentDid": { "type": "string", "pattern": "^did:" },
    "allowedTaskTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "maxSpend": { "type": "number", "exclusiveMinimum": 0 },
    "currency": { "type": "string", "minLength": 1 },
    "validFrom": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "policyVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "delegation": {
      "type": "object",
      "required": ["depth"],
      "properties": {
        "depth": { "type": "integer", "minimum": 0 },
        "parentMandateId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["maxDelegationDepth", "emergencyStop"],
      "properties": {
        "allowedCounterparties": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^did:" }
        },
        "deniedCounterparties": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^did:" }
        },
        "allowedJurisdictions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        },
        "maxDelegationDepth": { "type": "integer", "minimum": 0 },
        "emergencyStop": { "type": "boolean" },
        "requireHumanApprovalAboveMinor": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "nonce": { "type": "string", "minLength": 1 },
    "signature": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
