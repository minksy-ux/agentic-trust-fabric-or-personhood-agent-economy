{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentictrust.example/specs/agent-card.json",
  "title": "Agent Card",
  "type": "object",
  "required": ["schemaVersion", "id", "agentDid", "capabilities", "endpoint", "acceptedCurrencies", "supportedProtocolVersions", "skillAttestationIds", "bondIds", "insurancePolicyIds", "signature"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "agentDid": { "type": "string", "pattern": "^did:" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "endpoint": { "type": "string", "format": "uri" },
    "acceptedCurrencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "supportedProtocolVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
    },
    "skillAttestationIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "bondIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "insurancePolicyIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "signature": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
