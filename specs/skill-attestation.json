{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentictrust.example/specs/skill-attestation.json",
  "title": "Skill Attestation",
  "type": "object",
  "required": ["schemaVersion", "id", "subjectDid", "issuerDid", "domain", "skill", "metrics", "evidenceUri", "issuedAt", "expiresAt", "signature"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "subjectDid": { "type": "string", "pattern": "^did:" },
    "issuerDid": { "type": "string", "pattern": "^did:" },
    "domain": { "type": "string", "minLength": 1 },
    "skill": { "type": "string", "minLength": 1 },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "value", "unit"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": "number" },
          "unit": { "enum": ["count", "percentage", "score"] }
        },
        "additionalProperties": false
      }
    },
    "evidenceUri": { "type": "string", "format": "uri" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "executionEnvironment": { "type": "string", "minLength": 1 },
    "signature": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}